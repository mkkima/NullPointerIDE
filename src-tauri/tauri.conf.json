{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NullPointer",
  "version": "0.1.0",
  "identifier": "dev.nullpointer.ide",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "title": "NullPointer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A fast, focused code editor",
    "longDescription": "NullPointer is a minimal native code editor optimized for focus and speed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
