{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NullPointer",
  "version": "0.1.0",
  "identifier": "dev.nullpointer.ide",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build",
      "wait": true
    },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "title": "NullPointer",
        "width": 1600,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "A fast, focused code editor",
    "longDescription": "NullPointer is a minimal native code editor optimized for focus and speed.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MDAzRUMxODA2NzM4MjIKUldRaU9HZUF3VDRBUkJkZnR4cjJ3SVlxRTh1elFsellIZi9oY0RxMVFMeUpzSU8zRHpGTC9kNUMK",
      "endpoints": [
        "https://github.com/mkkima/NullPointerIDE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
